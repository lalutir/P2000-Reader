p2000.lalutir.com {
    # Proxy API and WebSocket to FastAPI
    handle /api/* {
        reverse_proxy localhost:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Serve the React SPA for everything else
    handle {
        root * /home/lalutir/p2000-reader/frontend/web/dist
        try_files {path} /index.html
        file_server
    }
}
