lalutir.com, www.lalutir.com {
    # Proxy API and WebSocket to FastAPI (must come before file_server)
    handle /api/* {
        reverse_proxy localhost:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Serve the React web frontend
    root * /home/lalutir/p2000-reader/frontend/web/dist
    file_server

    # SPA fallback — send unknown paths to index.html
    try_files {path} /index.html
}
